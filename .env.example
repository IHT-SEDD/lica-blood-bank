# ------------------------------
# APPLICATION
# ------------------------------
# ---------- Application Display Name 
APP_NAME="LICA Blood Bank"
# ---------- Application Environment, local | production | staging 
APP_ENV=local
# ---------- Laravel application encryption key
APP_KEY=
# ---------- Enable detailed Laravel error reporting, set to false in production
APP_DEBUG=true
# ---------- Base URL used by Laravel
APP_URL=http://lica-blood-bank.public:8080
# ---------- Application version
APP_VERSION=v1.3.0

# ------------------------------
# APPLICATION LOCALIZATION
# ------------------------------
# ---------- Application locale
APP_LOCALE=id
# ---------- Application timezone
APP_TIMEZONE=Asia/Jakarta
# ---------- Fallback locale
APP_FALLBACK_LOCALE=id
# ---------- Faker locale
APP_FAKER_LOCALE=id_ID

# ------------------------------
# APPLICATION MAINTENANCE
# ------------------------------
# ---------- Maintenance mode driver
APP_MAINTENANCE_DRIVER=file
# ---------- Uncomment when using database-backed maintenance mode
# APP_MAINTENANCE_STORE=database

# ------------------------------
# PHP
# ------------------------------
# ---------- Number of PHP CLI development server workers
# ---------- Usually unnecessary when using Laragon/Apache/Nginx
# PHP_CLI_SERVER_WORKERS=4
# ---------- Password hashing cost, 12 is default value
BCRYPT_ROUNDS=12

# ------------------------------
# LOGGING
# ------------------------------
# ---------- Log channel
LOG_CHANNEL=stack
# ---------- Log stack
LOG_STACK=single
# ---------- Deprecated feature logging
LOG_DEPRECATIONS_CHANNEL=null
# ---------- Log verbosity, debug | info | notice | warning | error
LOG_LEVEL=debug

# ------------------------------
# DATABASES
# ------------------------------
# ---------- Primary database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_lica_blood_bank
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------
# SESSION
# ------------------------------
# ---------- Session storage
# ---------- database is suitable for development, redis is recommended for higher-scale production
SESSION_DRIVER=database
# ---------- Session lifetime in minutes
SESSION_LIFETIME=120
# ---------- Encrypt session data
SESSION_ENCRYPT=false
# ---------- Session cookie path
SESSION_PATH=/
# ---------- Session cookie domain
SESSION_DOMAIN=null

# ------------------------------
# BROADCASTING
# ------------------------------
# ---------- Broadcasting connection
BROADCAST_CONNECTION=log

# ------------------------------
# FILESYSTEM
# ------------------------------
# ---------- Default filesystem disk
FILESYSTEM_DISK=local

# ------------------------------
# QUEUE
# ------------------------------
# ---------- Queue backend
# ---------- database is suitable for development, redis is recommended for higher-throughput production
QUEUE_CONNECTION=database

# ------------------------------
# CACHE
# ------------------------------
# ---------- Application cache backend
# ---------- database is suitable for development, redis is recommended for production
CACHE_STORE=database
# ---------- Optional cache prefix
# CACHE_PREFIX=

# ------------------------------
# MEMCACHED
# ------------------------------
# ---------- Memcached server
MEMCACHED_HOST=127.0.0.1

# ------------------------------
# REDIS
# ------------------------------
# ---------- Redis PHP client
REDIS_CLIENT=phpredis
# ---------- Redis server
REDIS_HOST=127.0.0.1
# ---------- Redis password
REDIS_PASSWORD=null
# ---------- Redis port
REDIS_PORT=6379
# ---------- Default Redis database
REDIS_DB=0
# ---------- Redis database dedicated to cache
REDIS_CACHE_DB=1
# ---------- Redis key prefix
REDIS_PREFIX=lica_blood_bank

# ------------------------------
# MAIL
# ------------------------------
# ---------- Mail transport
MAIL_MAILER=log
# ---------- Mail encryption scheme
MAIL_SCHEME=null
# ---------- SMTP host
MAIL_HOST=127.0.0.1
# ---------- SMTP port
MAIL_PORT=2525
# ---------- SMTP username
MAIL_USERNAME=null
# ---------- SMTP password
MAIL_PASSWORD=null
# ---------- Default sender
MAIL_FROM_ADDRESS="hello@example.com"
# ---------- Default sender name
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------
# AWS / S3
# ------------------------------
# ---------- AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ---------- AWS region
AWS_DEFAULT_REGION=us-east-1
# ---------- S3 bucket
AWS_BUCKET=
# ---------- Use path-style endpoint
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------
# API
# ------------------------------
# ---------- API route prefix
API_PREFIX=
# ---------- API Version
API_VERSION=v1

# ------------------------------
# VITE
# ------------------------------
# ---------- Application name exposed to frontend
VITE_APP_NAME="${APP_NAME}"
# ---------- Vite server host
VITE_APP_HOST=127.0.0.1 # ubah ke 0.0.0.0 jika production
# ---------- Vite server port
VITE_APP_PORT=5173
# ---------- Vite websocket host
VITE_HMR_HOST= # Isi dengan IP Server jika production
# ---------- Vite websocket port
VITE_HMR_PORT=  # Wajib memiliki nilai yang sama dengan VITE_APP_PORT jika production
# ---------- Vite websocket protocol
VITE_HMR_PROTOCOL=  # Isi dengan ws jika production